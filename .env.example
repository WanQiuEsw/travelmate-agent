MODEL_API_KEY=
# deepseek-flash 就是 DeepSeek-V4.1-Flash 的官方模型名；写 deepseek-v4.1-flash 会自动映射成它
MODEL_NAME=deepseek-flash
MODEL_BASE_URL=https://api.deepseek.com
# auto：有 DeepSeek 密钥时用官方 Search API（/v1/tools/search），否则回退 Tavily；deepseek / tavily 可强制指定
SEARCH_PROVIDER=auto
# research：金额环节联网查门票与人均价格；plan：只做流程规划，不调研价格，金额一律标待核实
COST_MODE=research
# 审查用更快的模型，留空则与主模型相同；只影响审阶段，不影响正文质量
REVIEW_MODEL_NAME=
TAVILY_API_KEY=
# 可选 mcp。使用前执行 uv sync --extra rail。默认使用原有 HTTP API。
TAVILY_SEARCH_TRANSPORT=
AMAP_API_KEY=
DATABASE_PATH=data/checkpoints.sqlite
# 邀请登录：与会话共用上述 SQLite，不需要额外数据库服务。
AUTH_DAILY_LIMIT=20
AUTH_GLOBAL_DAILY_LIMIT=100
AUTH_SESSION_DAYS=7
# 公网 HTTPS 必须 true；仅本地 HTTP 开发改为 false。
AUTH_COOKIE_SECURE=true
KNOWLEDGE_DIR=knowledge
# local: 本地字符匹配；aliyun: 阿里云百炼文档搜索知识库（北京）
KNOWLEDGE_PROVIDER=local
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_WORKSPACE_ID=
ALIYUN_INDEX_ID=
# 可选：scripts/tag_kb.py 默认会自己发现类目，指定它可只处理一个
ALIYUN_CATEGORY_ID=

# 本地免费 12306 MCP；留空禁用。先运行 npx -y 12306-mcp@0.3.10 --host 127.0.0.1 --port 8081
# 未配置时铁路自动改用联网搜索取参考票价与时刻（没有车次号和余票，标注待核实）
RAIL_MCP_URL=
