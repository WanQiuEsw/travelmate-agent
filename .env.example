MODEL_API_KEY=
# deepseek-flash 就是 DeepSeek-V4.1-Flash 的官方模型名；写 deepseek-v4.1-flash 会自动映射成它
MODEL_NAME=deepseek-flash
MODEL_BASE_URL=https://api.deepseek.com
# auto：有 DeepSeek 密钥时用官方 Search API（/v1/tools/search），否则回退 Tavily；deepseek / tavily 可强制指定
SEARCH_PROVIDER=auto
# research：金额环节联网查门票与人均价格；plan：只做流程规划，不调研价格，金额一律标待核实
COST_MODE=research
# 审查用更快的模型，留空则与主模型相同；只影响审阶段，不影响正文质量
REVIEW_MODEL_NAME=
# 整轮规划的软时限（秒，默认55）：超时后跳过模型复核与剩余重排，先交付方案并提示
PLAN_BUDGET_SECONDS=55
TAVILY_API_KEY=
# 可选 mcp。使用前执行 uv sync --extra rail。默认使用原有 HTTP API。
TAVILY_SEARCH_TRANSPORT=
AMAP_API_KEY=
DATABASE_PATH=data/checkpoints.sqlite
# 邀请登录：与会话共用上述 SQLite，不需要额外数据库服务。
AUTH_DAILY_LIMIT=20
AUTH_GLOBAL_DAILY_LIMIT=100
AUTH_SESSION_DAYS=7
# 公网 HTTPS 必须 true；仅本地 HTTP 开发改为 false。
AUTH_COOKIE_SECURE=true
KNOWLEDGE_DIR=knowledge
# local: 本地字符匹配；aliyun: 阿里云百炼文档搜索知识库（北京）
KNOWLEDGE_PROVIDER=local
# 小红书：仅个人低频演示；网页端登录后将 Cookie 放在本地 .env，不要发送或提交。
# 配置 Cookie 后自动启用；设 false 可临时关闭。先执行 uv sync --extra aliyun --extra xhs
XHS_ENABLED=true
XHS_COOKIE=
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_WORKSPACE_ID=
ALIYUN_INDEX_ID=
# 可选：scripts/tag_kb.py 默认会自己发现类目，指定它可只处理一个
ALIYUN_CATEGORY_ID=

# 本地免费 12306 MCP；留空禁用。先运行 npx -y 12306-mcp@0.3.10 --host 127.0.0.1 --port 8081
# 未配置时铁路自动改用联网搜索取参考票价与时刻（没有车次号和余票，标注待核实）
RAIL_MCP_URL=

# 语音成行：只把录音转成文字回填到页面，用户确认后才走 /chat。
# openai=任何 OpenAI 兼容的 /audio/transcriptions；local=faster-whisper 本地跑，零成本
# 留空时：配了 ASR_API_KEY 走 openai，没配走 local
ASR_PROVIDER=
# 下面三个是一组，必须同一家厂商。示例是硅基流动（SenseVoiceSmall 目前免费，需实名后申请 Key）
# 换 OpenAI/Groq 的 Whisper 时三个一起改：https://api.openai.com/v1 + whisper-1
ASR_BASE_URL=https://api.siliconflow.cn/v1
ASR_API_KEY=
ASR_MODEL=FunAudioLLM/SenseVoiceSmall
# 识别语言；留空不传该参数
ASR_LANGUAGE=zh
# 把 35 个常见地名作为提示词传给识别接口；不支持该参数的厂商会自动去掉重试一次
ASR_PROMPT=1
ASR_TIMEOUT=30
# 本地识别用的模型，small 够用；机器慢可换 tiny
ASR_LOCAL_MODEL=small

# 行前保鲜：出发前 N 天自动复核票价、开放时间和车次，只报变动
WATCH_LEAD_DAYS=3
# 每版每次重跑几次检索（车次优先，其次票价/开放时间，最后地点）
WATCH_MAX_QUERIES=3
# 同一版本两次复核的最小间隔，避免反复花钱
WATCH_INTERVAL_HOURS=24
# 定时任务开关与扫描间隔（分钟）
WATCH_SCHEDULER=1
WATCH_SCHEDULER_MINUTES=60
