MODEL_API_KEY=
MODEL_NAME=deepseek-flash
MODEL_BASE_URL=https://api.deepseek.com
TAVILY_API_KEY=
AMAP_API_KEY=
DATABASE_PATH=data/checkpoints.sqlite
# 邀请登录：与会话共用上述 SQLite，不需要额外数据库服务。
AUTH_DAILY_LIMIT=20
AUTH_GLOBAL_DAILY_LIMIT=100
AUTH_SESSION_DAYS=7
# 公网 HTTPS 必须 true；仅本地 HTTP 开发改为 false。
AUTH_COOKIE_SECURE=true
KNOWLEDGE_DIR=knowledge
# local: 本地字符匹配；aliyun: 阿里云百炼文档搜索知识库（北京）
KNOWLEDGE_PROVIDER=local
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_WORKSPACE_ID=
ALIYUN_INDEX_ID=

# 本地免费 12306 MCP；留空禁用。先运行 npx -y 12306-mcp@0.3.10 --host 127.0.0.1 --port 8081
RAIL_MCP_URL=
